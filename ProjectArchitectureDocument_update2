**User Story 4: Generate Seating Arrangements**
```python
import math
import requests
import time

def test_generate_seating():
    solve_request = {
        "groups": [
            {"id": "bride", "parentId": None, "guestCount": 0, "edgeWeight": 1.0},
            {"id": "bride_parents", "parentId": "bride", "guestCount": 4, "edgeWeight": 3.0},
            {"id": "bride_friends", "parentId": "bride", "guestCount": 5, "edgeWeight": 1.5},
            {"id": "bride_cousins", "parentId": "bride", "guestCount": 3, "edgeWeight": 1.0},
            {"id": "groom", "parentId": None, "guestCount": 0, "edgeWeight": 1.0},
            {"id": "groom_parents", "parentId": "groom", "guestCount": 4, "edgeWeight": 3.0},
            {"id": "groom_friends", "parentId": "groom", "guestCount": 5, "edgeWeight": 1.5},
            {"id": "groom_cousins", "parentId": "groom", "guestCount": 3, "edgeWeight": 1.0},
            {"id": "coworkers", "parentId": None, "guestCount": 3, "edgeWeight": 0.8}
        ],
        "tableCapacity": 6,
        "alpha": 2.0,
        "p": 2.0
    }
    total_people = sum(g["guestCount"] for g in solve_request["groups"])
    theoretical_min_tables = math.ceil(total_people / solve_request["tableCapacity"])

    response = requests.post("http://localhost/solve", json=solve_request)
    assert response.status_code == 200
    job_id = response.json()["jobId"]
    for _ in range(60):
        status = requests.get(f"http://localhost/solve/{job_id}").json()
        if status["status"] == "done":
            break
        time.sleep(2)
    assert status["status"] == "done"
    assert len(status["solutions"]) >= 1
    assert status["solutions"][0]["tables"] >= theoretical_min_tables
    assert sum(chunk["size"] for chunk in status["solutions"][0]["chunks"]) == total_people

test_generate_seating()
```

