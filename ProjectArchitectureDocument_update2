**User Story 11: Search for a Guest's Table**
```python
def test_search_guest_table():
    arrangement = {
        "tables": [
            {"tableId": 1, "guests": [{"guestId": "p1", "guestName": "Alice"}]},
            {"tableId": 2, "guests": [{"guestId": "p2", "guestName": "Bob"}]}
        ]
    }
    query = "bob"
    results = [
        {**guest, "tableId": table["tableId"]}
        for table in arrangement["tables"]
        for guest in table["guests"]
        if query in guest["guestName"].lower()
    ]
    assert len(results) == 1
    assert results[0]["guestName"] == "Bob"
    assert results[0]["tableId"] == 2

test_search_guest_table()
