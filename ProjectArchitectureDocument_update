#### Sample Test for User Story 3

This test targets the actual solver normalization function in `solver/api.py`, rather than an invented `/api/events/...` backend.

```python
from api import _prepare_solver_groups


def test_prepare_solver_groups_handles_multiple_roots_internal_guests_and_chunking():
    ui_groups = [
        {"id": "hosts", "parentId": None, "guestCount": 2, "edgeWeight": 1.0},
        {"id": "hosts_family", "parentId": "hosts", "guestCount": 7, "edgeWeight": 1.5},
        {"id": "partner", "parentId": None, "guestCount": 0, "edgeWeight": 1.0},
    ]

    solver_groups = _prepare_solver_groups(ui_groups, table_capacity=4)
    ids = {g["id"] for g in solver_groups}

    # Multiple roots are normalized under a synthetic root.
    assert "_root" in ids

    # Direct guests on an internal node become a synthetic leaf.
    assert any(
        g["id"] == "_direct_hosts"
        and g["size"] == 2
        and g["parent_id"] == "hosts"
        for g in solver_groups
    )

    # Oversized leaf groups are chunked to respect table capacity.
    chunk_sizes = sorted(
        g["size"] for g in solver_groups
        if g["id"].startswith("_chunk_hosts_family_")
    )
    assert chunk_sizes == [3, 4]
```

#### Sample Test for User Story 7

The original draft's `test_generate_seating` was too weak and also used the wrong payload shape. The repository's real solver endpoint expects `guestCount`, not inline guest objects. The version below is intentionally tighter and more non-trivial.

```python
import math
import time
from api import app


def test_generate_seating_async_nontrivial():
    client = app.test_client()

    payload = {
        "groups": [
            {"id": "hosts", "parentId": None, "guestCount": 2, "edgeWeight": 1.0},
            {"id": "hosts_parents", "parentId": "hosts", "guestCount": 6, "edgeWeight": 3.0},
            {"id": "hosts_friends", "parentId": "hosts", "guestCount": 5, "edgeWeight": 1.2},
            {"id": "partner", "parentId": None, "guestCount": 1, "edgeWeight": 1.0},
            {"id": "partner_parents", "parentId": "partner", "guestCount": 5, "edgeWeight": 3.0},
            {"id": "partner_cousins", "parentId": "partner", "guestCount": 4, "edgeWeight": 1.5},
            {"id": "coworkers", "parentId": None, "guestCount": 4, "edgeWeight": 0.8},
            {"id": "band", "parentId": None, "guestCount": 3, "edgeWeight": 0.5},
        ],
        "tableCapacity": 6,
        "alpha": 2.0,
        "p": 2.0,
    }

    total_people = sum(g["guestCount"] for g in payload["groups"])
    theoretical_min_tables = math.ceil(total_people / payload["tableCapacity"])

    start = client.post("/solve", json=payload)
    assert start.status_code == 200
    job_id = start.get_json()["jobId"]

    deadline = time.time() + 120
    final = None
    while time.time() < deadline:
        poll = client.get(f"/solve/{job_id}")
        data = poll.get_json()
        if data["status"] == "done":
            final = data
            break
        assert data["status"] == "pending"
        time.sleep(0.25)

    assert final is not None, "solver job did not finish within test timeout"
    assert len(final["solutions"]) >= 1

    for solution in final["solutions"]:
        assert solution["tables"] >= theoretical_min_tables
        assert sum(chunk["size"] for chunk in solution["chunks"]) == total_people
        assert all(chunk["size"] <= payload["tableCapacity"] for chunk in solution["chunks"])
```

#### Sample Test for User Story 8

This sample checks the direct Python solver contract in `solver/solve.py`: solutions are sorted by table count and reduced to one best solution per table count.

```python
from solve import solve


def test_solve_returns_frontier_sorted_by_table_count():
    groups = [
        {"id": "root", "size": 0, "parent_id": 0, "edge_weight": 1.0},
        {"id": "family_a", "size": 4, "parent_id": "root", "edge_weight": 2.0},
        {"id": "family_b", "size": 4, "parent_id": "root", "edge_weight": 2.0},
        {"id": "friends_a", "size": 3, "parent_id": "root", "edge_weight": 1.0},
        {"id": "friends_b", "size": 3, "parent_id": "root", "edge_weight": 1.0},
        {"id": "coworkers", "size": 2, "parent_id": "root", "edge_weight": 0.5},
    ]

    # Smaller pop_size keeps the sample lightweight while preserving the API contract.
    solutions = solve(groups, table_capacity=6, pop_size=30)

    assert solutions
    table_counts = [s["tables"] for s in solutions]
    assert table_counts == sorted(table_counts)
    assert len(table_counts) == len(set(table_counts))

    # One assignment entry per solver leaf group.
    for solution in solutions:
        assert set(solution.keys()) == {"tables", "penalty", "assignment"}
        assert len(solution["assignment"]) == 5
```

